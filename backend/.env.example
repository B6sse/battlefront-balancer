# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.
# Used by bootRun (local backend) and by docker compose (postgres + backend containers).

# Database. In Docker, POSTGRES_HOST is overridden to "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=battlefront_balancer
POSTGRES_USER=battlefront
# Production: use a long random value, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me

SERVER_PORT=8080
SESSION_TIMEOUT=30m
# true in production (HTTPS); false only for local development over plain http
SESSION_COOKIE_SECURE=false

RATE_LIMIT_LOGIN_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
